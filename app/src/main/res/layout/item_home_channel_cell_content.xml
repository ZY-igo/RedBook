<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/channelCellContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/channelChip"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/deleteBadge"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-6dp"
        android:layout_marginEnd="-4dp"
        android:background="@drawable/bg_xhs_channel_delete_badge"
        android:gravity="center"
        android:text="@string/close_symbol"
        android:textColor="@color/xhs_card"
        android:visibility="gone" />
</FrameLayout>
