<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/footerIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_xhs_drawer_footer_icon"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/ic_xhs_scan"
        app:tint="@color/xhs_drawer_footer_icon_tint" />

    <TextView
        android:id="@+id/footerLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/drawer_footer_label"
        android:textColor="@color/xhs_drawer_text_secondary"
        android:textSize="12sp" />
</LinearLayout>
