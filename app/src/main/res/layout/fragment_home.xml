<?xml version="1.0" encoding="utf-8"?>
<!--
    文件说明：fragment_home.xml
    作用：定义当前 XML 资源文件在项目中的配置职责。
    备注：用于标注当前资源或配置文件的职责，便于后续维护与排查。
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xhs_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/xhs_bg">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/buttonMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_xhs_toolbar_button"
                android:contentDescription="@string/desc_open_menu"
                android:padding="8dp"
                android:src="@drawable/ic_xhs_menu"
                app:tint="@color/xhs_text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabFollowing"
                    style="@style/XhsMainTab" />

                <TextView
                    android:id="@+id/tabDiscover"
                    style="@style/XhsMainTab" />

                <TextView
                    android:id="@+id/tabNearby"
                    style="@style/XhsMainTab" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/buttonSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_xhs_toolbar_button"
                android:contentDescription="@string/desc_search"
                android:padding="8dp"
                android:src="@drawable/ic_xhs_search"
                app:tint="@color/xhs_text_primary" />
        </LinearLayout>

        <View
            android:id="@+id/topBarDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#EAEAEA"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar" />

        <LinearLayout
            android:id="@+id/discoverContentContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingTop="0dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBarDivider">

            <LinearLayout
                android:id="@+id/categorySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <HorizontalScrollView
                        android:id="@+id/categoryScroll"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fillViewport="true"
                        android:overScrollMode="never"
                        android:scrollbars="none"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/categoryExpand"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:id="@+id/compactCategoryContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <ImageView
                        android:id="@+id/categoryExpand"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_xhs_toolbar_button_small"
                        android:contentDescription="@string/desc_expand_categories"
                        android:padding="4dp"
                        android:src="@drawable/ic_xhs_chevron_down"
                        app:layout_constraintBottom_toBottomOf="@id/categoryScroll"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/categoryScroll"
                        app:tint="@color/xhs_text_secondary" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <com.zhengyang.redbook.ui.widget.PullRefreshLayout
                android:id="@+id/discoverRefreshLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="4dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="1dp"
                    android:paddingBottom="96dp" />
            </com.zhengyang.redbook.ui.widget.PullRefreshLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/followingContentContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/xhs_bg"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <ScrollView
                android:id="@+id/followingEmptyContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="96dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="24dp"
                        android:paddingTop="88dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="48dp">

                        <TextView
                            android:id="@+id/followingEmptyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/xhs_text_primary"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-light"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/followingEmptySubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/xhs_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:id="@+id/followingSuggestTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/xhs_text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/followingSuggestHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/xhs_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/followingSuggestionContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/followingFeedContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <HorizontalScrollView
                    android:id="@+id/followingStoriesScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="false"
                    android:overScrollMode="never"
                    android:paddingStart="10dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/followingStoryContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <com.zhengyang.redbook.ui.widget.PullRefreshLayout
                    android:id="@+id/followingRefreshLayout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/followingRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingStart="4dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="1dp"
                        android:paddingBottom="96dp" />
                </com.zhengyang.redbook.ui.widget.PullRefreshLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/categoryManagerPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/xhs_card"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="我的频道"
                        android:textColor="@color/xhs_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/myChannelHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="点击进入频道"
                        android:textColor="@color/xhs_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/panelEditButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_xhs_panel_action"
                    android:gravity="center"
                    android:minWidth="76dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="进入编辑"
                    android:textColor="@color/xhs_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/panelCollapse"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_xhs_toolbar_button_small"
                    android:contentDescription="@string/desc_expand_categories"
                    android:padding="6dp"
                    android:src="@drawable/ic_xhs_chevron_down"
                    app:tint="@color/xhs_text_secondary" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="28dp">

                    <LinearLayout
                        android:id="@+id/myChannelContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="推荐频道"
                            android:textColor="@color/xhs_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="点击添加频道"
                            android:textColor="@color/xhs_text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/recommendedChannelContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="312dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/xhs_drawer_bg"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/drawerScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/drawerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="18dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="36dp" />

                <include layout="@layout/layout_xhs_drawer_section_primary" />
                <include layout="@layout/layout_xhs_drawer_section_secondary" />
                <include layout="@layout/layout_xhs_drawer_section_drafts" />
                <include layout="@layout/layout_xhs_drawer_section_orders" />
                <include layout="@layout/layout_xhs_drawer_section_tools" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/drawerFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="18dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <include layout="@layout/layout_xhs_drawer_footer_item" />
            <include layout="@layout/layout_xhs_drawer_footer_item" />
            <include layout="@layout/layout_xhs_drawer_footer_item" />
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
