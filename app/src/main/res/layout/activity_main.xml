<?xml version="1.0" encoding="utf-8"?>
<!--
    文件说明： activity_main.xml
    作用： 定义界面布局层级结构，包括视图组织、尺寸关系和静态属性。
    备注：该注释用于说明资源文件在界面结构、视觉表达或运行配置中的定位。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xhs_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/pageContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tabGravity="fill"
        app:tabIndicator="@null"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="0dp"
        app:tabInlineLabel="true"
        app:tabMaxWidth="0dp"
        app:tabMode="fixed"
        app:tabPaddingTop="8dp"
        app:tabPaddingBottom="20dp"
        app:tabRippleColor="@android:color/transparent"
        app:tabTextAppearance="@style/TextAppearance.RedBook.BottomTab"
        app:tabTextColor="@color/bottom_nav_item_color"
        app:tabSelectedTextColor="@color/bottom_nav_selected" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/centerAddButton"
        android:layout_width="44dp"
        android:layout_height="32dp"
        android:layout_marginBottom="18dp"
        android:translationZ="12dp"
        app:cardBackgroundColor="@color/xhs_accent"
        app:cardCornerRadius="8dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/xhs_add_button_stroke"
        app:strokeWidth="1dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/nav_add"
            android:padding="3dp"
            android:src="@drawable/ic_xhs_plus"
            app:tint="@android:color/white" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
