<?xml version="1.0" encoding="utf-8"?>
<!--
    文件说明：layout_xhs_drawer_section_drafts.xml
    作用：定义当前 XML 资源文件在项目中的配置职责。
    备注：用于标注当前资源或配置文件的职责，便于后续维护与排查。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/xhs_drawer_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/xhs_drawer_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="2dp">

        <include
            android:id="@+id/drawerDrafts"
            layout="@layout/layout_xhs_drawer_row" />

        <include
            android:id="@+id/drawerActivity"
            layout="@layout/layout_xhs_drawer_row" />

        <include
            android:id="@+id/drawerHistory"
            layout="@layout/layout_xhs_drawer_row" />

        <include
            android:id="@+id/drawerDownload"
            layout="@layout/layout_xhs_drawer_row" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
