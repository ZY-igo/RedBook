<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RedBook" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/xhs_bg</item>
        <item name="android:navigationBarColor">@color/xhs_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.RedBook.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/xhs_splash_bg</item>
        <item name="android:statusBarColor">@color/xhs_splash_bg</item>
        <item name="android:navigationBarColor">@color/xhs_splash_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.RedBook.Search" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/xhs_search_bg</item>
        <item name="android:colorBackground">@color/xhs_search_bg</item>
        <item name="android:statusBarColor">@color/xhs_search_bg</item>
        <item name="android:navigationBarColor">@color/xhs_search_bg</item>
        <item name="colorPrimary">@color/xhs_search_accent</item>
        <item name="colorSecondary">@color/xhs_search_accent</item>
        <item name="colorTertiary">@color/xhs_search_accent</item>
        <item name="colorSurface">@color/xhs_search_bg</item>
        <item name="colorSurfaceContainer">@color/xhs_search_panel_bg</item>
        <item name="colorOnSurface">@color/xhs_search_text_primary</item>
        <item name="android:textColorPrimary">@color/xhs_search_text_primary</item>
        <item name="android:textColorSecondary">@color/xhs_search_hint_text</item>
        <item name="colorControlNormal">@color/xhs_search_icon_muted</item>
        <item name="colorControlActivated">@color/xhs_search_accent</item>
        <item name="colorControlHighlight">@color/xhs_search_chip_bg</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="TextAppearance.RedBook.BottomTab" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="XhsMainTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">18dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:background">@drawable/bg_xhs_main_tab</item>
        <item name="android:textColor">@color/xhs_main_tab_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="XhsCategoryTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">22dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/bg_xhs_category_tab</item>
        <item name="android:textColor">@color/xhs_category_tab_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="XhsCategoryExpandedTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_xhs_category_expand_chip</item>
        <item name="android:textColor">@color/xhs_category_expand_chip_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
